# archive（本机归档工具）的配置。复制为 archive/archive.env（已 gitignore，不会被部署到服务器）后按需修改。
# 文件不存在时用下面这组默认值；写法同 deploy/deploy.env（KEY=VALUE，# 开头是注释），只读取、不执行。
#
#   cp archive/archive.env.example archive/archive.env

# ssh 目标（user@host）
SERVER=root@104.249.172.32

# 服务器上的程序目录
REMOTE=/opt/zjip-monitor

# 本机归档目录：附件、快照、事件日志和 archive.sqlite 都放这里。
# 只增不减——这里是正本，请纳入 Time Machine 等备份。
ARCHIVE_DIR=~/zjip-archive

# ssh 命令，可带参数，如 "ssh -p 2222 -o ConnectTimeout=10"
SSH_CMD=ssh

# 也可以用环境变量 ZJIP_ARCHIVE_ENV=... 指定别的配置文件
