# 单账户测试用（阶段 1）；阶段 2 改用加密的 accounts.enc
ZJIP_ACCOUNT=your_username_here
ZJIP_PASSWORD=your_password_here

# 阶段 2 加密密钥（由 scripts/encrypt_accounts.py 生成）
# FERNET_KEY=

# Web 管理后台登录（HTTP Basic Auth）
# WEB_PASS 必须设置为强口令，否则 web 拒绝启动；
# 本地开发可设 WEB_ALLOW_DEFAULT_PASS=1 豁免该检查
WEB_USER=admin
WEB_PASS=

# 小程序访问 /api/* 的密钥（建议 openssl rand -hex 16 生成，需与小程序端一致）
API_KEY=

# WEB_RELOAD=1  # uvicorn 热重载，仅开发环境
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
