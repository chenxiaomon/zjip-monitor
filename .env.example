# 单账户测试用（阶段 1）；阶段 2 改用加密的 accounts.enc
ZJIP_ACCOUNT=your_username_here
ZJIP_PASSWORD=your_password_here

# 阶段 2 加密密钥（由 scripts/encrypt_accounts.py 生成）
# FERNET_KEY=

# 备用管理员（登录页 + 会话 cookie；可见全部并管理一切）。
# 日常请在控制台「用户」页给每人建个人账号（存在 config/users.yaml）；
# 这一个只用于救场（用户文件坏了 / 管理员被误删），也是脚本 / curl 的 Basic Auth 凭据。
# WEB_PASS 必须设置为强口令，否则 web 拒绝启动；
# 本地开发可设 WEB_ALLOW_DEFAULT_PASS=1 豁免该检查
WEB_USER=admin
WEB_PASS=

# 已停用：旧的分组账号表（明文口令）。升级后控制台第一次启动时，若
# config/users.yaml 还不存在，会把这里的用户以「只读」导入一次；之后请删除本行。
# WEB_USERS=usera:passa:group_a,userb:passb:group_b

# 会话 cookie 签名密钥（可选；未设置时自动从 FERNET_KEY 派生）
# SESSION_SECRET=
# SESSION_MAX_AGE_HOURS=12

# 给脚本 / curl 访问 /api/* 用的管理员级密钥（X-API-Key 头，建议 openssl rand -hex 16 生成）；
# 小程序已改为同事用控制台个人账号登录，不再需要它
API_KEY=
# 小程序登录凭证的有效天数（默认 30）
# API_TOKEN_DAYS=30

# （已取消）VIEW_TOKEN / VIEW_COOKIE_DAYS：只读看板 /view 现在必须登录控制台，按各人权限显示

# 控制台登录限速（进程内计数，重启清零；单 uvicorn worker 前提）
# 同一 IP+用户名连续失败 N 次后锁定；同一 IP 累计失败 M 次后锁定所有用户名。
# WEB_LOGIN_MAX_FAILURES=5
# WEB_LOGIN_IP_MAX_FAILURES=20
# WEB_LOGIN_WINDOW_SECONDS=900
# WEB_LOGIN_LOCK_SECONDS=900

# 允许发起写操作（POST/PUT/PATCH/DELETE）的额外来源，逗号分隔 host[:port]。
# 默认只允许与请求 Host 相同的来源；控制台通过第二个域名访问时才需要配置。
# WEB_ALLOWED_ORIGINS=console.example.com

# WEB_RELOAD=1  # uvicorn 热重载，仅开发环境
# WEB_HOST=127.0.0.1
# WEB_PORT=8000

# 日志（三个进程共用 src/logging_setup.py）
# 默认：stderr 输出 INFO（只有连着终端时才上色），同时落盘到 logs/
#   巡检（run_daemon.py / run_once.py） → logs/run_YYYY-MM-DD.log
#   控制台（uvicorn web.app:app）        → logs/web_YYYY-MM-DD.log
# 保留天数在 config/settings.yaml 的 retention.logs_keep_days / web_logs_keep_days。
# ZJIP_LOG_TO_FILE=0        只输出到 stderr，不落盘（测试或临时排查用）
# ZJIP_LOG_DIR=/var/log/zjip  改日志目录，默认是仓库根下的 logs/
