.page {
  padding: 24rpx;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

/* One company's login and scan state */
.company-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.state-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  padding: 4rpx 0;
}

.state-k {
  width: 120rpx;
  flex-shrink: 0;
  color: #888;
}

.state-v {
  color: #555;
  margin-right: 12rpx;
}

.state-error {
  display: block;
  font-size: 22rpx;
  color: #b91c1c;
  margin: 4rpx 0 8rpx 120rpx;
  word-break: break-all;
}

.act {
  margin: 16rpx 0 0;
  font-size: 24rpx;
}

.search {
  background: #fff;
  border-radius: 100rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.year-note {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.summary {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.record-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.reg-no {
  font-family: monospace;
  font-size: 24rpx;
  color: #888;
}

.record-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #222;
  display: block;
  margin-bottom: 12rpx;
}

.record-pills {
  margin-bottom: 8rpx;
}

.record-foot {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.company {
  font-size: 22rpx;
  color: #888;
  margin-right: 12rpx;
}

.apply-date {
  font-size: 22rpx;
  color: #bbb;
  margin-left: auto;
}

.more {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  padding: 24rpx 0;
}

.empty {
  text-align: center;
  color: #bbb;
  padding: 80rpx 0;
}
