<view class="page">

  <!-- 我负责的 / 全部: only when searching across companies -->
  <scope-bar wx:if="{{!company}}" scope="{{scope}}" bind:change="onScopeChange" />

  <!-- One company: its login and scan state, 立即巡检 and 去平台办理 -->
  <view wx:if="{{company && state}}" class="company-card">
    <view class="state-line">
      <text class="state-k">平台登录</text>
      <text wx:if="{{state.login.state === 'pending'}}" class="tag tag-muted">登录中…</text>
      <text wx:elif="{{state.login.state === 'error'}}" class="tag tag-danger">登录失败</text>
      <text wx:else class="state-v">{{state.login.label}}</text>
      <text wx:if="{{state.login.paused}}" class="tag tag-warn">已暂停 · 需在控制台更新密码</text>
    </view>
    <text wx:if="{{state.login.error}}" class="state-error">{{state.login.error}}</text>
    <view class="state-line">
      <text class="state-k">巡检</text>
      <text wx:if="{{state.scan.state === 'running'}}" class="tag tag-muted">巡检中…</text>
      <text wx:elif="{{state.scan.failed}}" class="tag tag-danger">上次巡检失败 · {{state.scan.label}}</text>
      <text wx:elif="{{state.scan.partial}}" class="tag tag-warn">{{state.scan.label}}</text>
      <text class="state-v">最后巡检 {{state.last_check}}</text>
    </view>
    <text wx:if="{{state.scan.error}}" class="state-error">{{state.scan.error}}</text>
    <button
      wx:if="{{state.can.scan}}"
      class="act"
      size="mini"
      disabled="{{state.scan.state === 'running' || state.scan_wait > 0}}"
      bindtap="onScan"
    >{{state.scan.state === 'running' ? '巡检中…' : (state.scan_wait > 0 ? state.waitMinutes + ' 分钟后可再巡检' : '立即巡检')}}</button>
    <platform-access wx:if="{{state.can.reveal}}" company="{{company}}" />
  </view>

  <input
    class="search"
    value="{{q}}"
    confirm-type="search"
    placeholder="{{company ? '在这家企业里搜索' : '搜索登记号、数据名称、企业'}}"
    bindconfirm="onSearch"
  />

  <scroll-view scroll-x class="chips">
    <text
      wx:for="{{groups}}"
      wx:key="key"
      class="chip {{status === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onStatus"
    >{{item.label}}</text>
  </scroll-view>

  <view wx:if="{{year}}" class="year-note">
    只看 {{year}} 年申请的 · <text class="link" bindtap="onClearYear">看全部年份</text>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <block wx:else>
    <view class="summary">共 {{total}} 条记录</view>

    <view
      wx:for="{{records}}"
      wx:key="key"
      class="record-card"
      bindtap="onTapRecord"
      data-company="{{item.company}}"
      data-reg="{{item.reg_no}}"
    >
      <view class="record-header">
        <text class="reg-no">{{item.reg_no}}</text>
        <text class="{{item.pillCls}}">{{item.status_label}}</text>
      </view>
      <text class="record-name">{{item.name || '—'}}</text>
      <view wx:if="{{item.due || item.cert}}" class="record-pills">
        <text wx:if="{{item.due}}" class="{{item.dueCls}}">{{item.due.label}}</text>
        <text wx:if="{{item.cert}}" class="{{item.certCls}}">{{item.cert.label}}</text>
      </view>
      <view class="record-foot">
        <text wx:if="{{!company}}" class="company">{{item.company}}</text>
        <text wx:if="{{item.mine && !company}}" class="tag tag-mine">我负责</text>
        <text class="apply-date">申请时间：{{item.apply_date}}</text>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="more">加载中...</view>
    <view wx:elif="{{records.length > 0 && page >= pages}}" class="more">没有更多了</view>
    <view wx:if="{{records.length === 0}}" class="empty">暂无记录</view>
  </block>

</view>
