.page {
  padding: 24rpx;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.card-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #444;
  margin-bottom: 16rpx;
}

/* Header */
.company-line {
  display: flex;
  align-items: center;
}

.company {
  font-size: 24rpx;
  color: #888;
  margin-right: 12rpx;
}

.title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #222;
  margin: 12rpx 0;
}

.pills {
  margin-bottom: 12rpx;
}

.reg-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
}

.reg-no {
  font-family: monospace;
  color: #888;
}

/* 概要 */
.kv {
  display: flex;
  font-size: 26rpx;
  padding: 8rpx 0;
}

.k {
  width: 160rpx;
  flex-shrink: 0;
  color: #888;
}

.v {
  flex: 1;
  color: #333;
  word-break: break-all;
}

.p {
  display: block;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.b {
  font-weight: 600;
}

.muted {
  color: #999;
}

.danger {
  color: #b91c1c;
}

.reasons {
  display: block;
  font-size: 24rpx;
  color: #555;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
  white-space: pre-wrap;
  line-height: 1.6;
}

/* 附件 */
.file {
  font-size: 26rpx;
  padding: 12rpx 0;
  word-break: break-all;
}

.file.archived {
  color: #aaa;
}

.xs {
  font-size: 22rpx;
  color: #999;
  margin-right: 12rpx;
}

/* 通知书要点 */
.notice {
  padding: 12rpx 0;
}

.notice-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.pill-current {
  background: #e6f1fb;
  color: #1d4ed8;
}

/* 状态历史 */
.hist {
  padding: 12rpx 0;
}

/* 列表里第二项起的分隔线（WXSS 不保证支持 :first-of-type） */
.sep {
  border-top: 1rpx solid #f0f0f0;
}

.hist-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.hist-change {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.to {
  color: #999;
  margin-right: 6rpx;
}
