.page {
  padding: 80rpx 48rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  margin-bottom: 64rpx;
}

.brand-name {
  font-size: 44rpx;
  font-weight: 600;
  color: #222;
}

.brand-sub {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
}

.field {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 12rpx;
}

.input {
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}

.error {
  background: #fcebeb;
  color: #791f1f;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.submit {
  margin-top: 16rpx;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 32rpx;
  line-height: 1.6;
}
