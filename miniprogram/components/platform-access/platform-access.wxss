.pa {
  margin-top: 16rpx;
}

.pa-btn {
  margin: 0;
  font-size: 24rpx;
}

.pa-panel {
  background: #f7f9fc;
  border: 1rpx solid #e6f1fb;
  border-radius: 12rpx;
  padding: 20rpx;
}

.pa-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  padding: 8rpx 0;
}

.pa-k {
  width: 140rpx;
  flex-shrink: 0;
  color: #888;
}

.pa-v {
  flex: 1;
  font-family: monospace;
  color: #222;
  word-break: break-all;
}

.pa-gap {
  margin-right: 20rpx;
}

.pa-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  font-size: 24rpx;
  margin-top: 12rpx;
}

.pa-close {
  color: #999;
  margin-left: auto;
}

.pa-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}
