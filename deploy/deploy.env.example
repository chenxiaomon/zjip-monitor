# deploy.sh 的配置。复制为 deploy/deploy.env（已 gitignore，不会被 rsync 到服务器）后按需修改。
# 文件不存在时 deploy.sh 用下面这组默认值；语法是 shell 赋值（会被 source）。
#
#   cp deploy/deploy.env.example deploy/deploy.env

# ssh 目标（user@host）
SERVER=root@104.249.172.32

# 服务器上的代码目录（systemd unit 的 WorkingDirectory）
REMOTE=/opt/zjip-monitor

# 每次部署前把代码目录打包到这里（不含 data/ logs/ .venv/），供 ./deploy.sh rollback 使用
BACKUP_DIR=/opt/zjip-monitor-backups

# 只保留最近 N 份备份（磁盘只剩几百 MB，不要调大）
KEEP_BACKUPS=3

# 远端磁盘剩余低于这个值（MB）就拒绝部署
# MIN_FREE_MB=200

# 也可以用环境变量而不是本文件：
#   DEPLOY_DELETE=1      rsync 加 --delete（先预览将删除的远端文件，输入 yes 才执行）
#   DEPLOY_SSH_CMD=...   替换 ssh 命令，可带参数，如 "ssh -p 2222 -o ConnectTimeout=10"
#   DEPLOY_ENV=...       用别的配置文件代替 deploy/deploy.env
